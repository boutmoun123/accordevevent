# -----------------------------------------------------------------------------
# Farah.event — local development environment
# Copy this file to .env. Never commit real credentials or production secrets.
# -----------------------------------------------------------------------------

# Runtime
COMPOSE_PROJECT_NAME=farah-event
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Farah.event API
PROJECT_NAME=Farah.event
API_V1_PREFIX=/api/v1
FRONTEND_PORT=3000
BACKEND_PORT=8000

# PostgreSQL (used to construct DATABASE_URL inside Docker Compose)
POSTGRES_DB=farah
POSTGRES_USER=farah
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://farah:change-me-local-only@postgres:5432/farah

# Authentication
# Generate a production value with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
AUTH_PEPPER=replace-with-at-least-32-random-characters
OTP_PROVIDER=mock
OTP_MOCK_CODE=000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_START_LIMIT=5
OTP_START_WINDOW_SECONDS=600
REQUEST_CODE_ATTEMPT_LIMIT=5
REQUEST_CODE_WINDOW_SECONDS=900

# Browser/API security. Use comma-separated origins; do not use a wildcard
# origin with credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60

# Gemini (AI and embeddings)
# Leave the API key empty to use deterministic/degraded local behavior, where
# supported. Never expose this value through NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=farah_female_profiles
QDRANT_HTTP_PORT=6333

# Frontend (this value is public and is embedded in the browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Development seed accounts. Local development only; replace or remove in
# every shared, staging, and production environment.
SEED_ADMIN_EMAIL=admin@farah.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026!
SEED_MATCHMAKER_EMAIL=matchmaker@farah.local
SEED_MATCHMAKER_PASSWORD=ChangeMe-Matchmaker-2026!
SEED_DEFAULT_PASSWORD=ChangeMe-Seed-2026!
# Name consumed by the backend seed configuration.
DEV_SEED_PASSWORD=ChangeMe-Seed-2026!
